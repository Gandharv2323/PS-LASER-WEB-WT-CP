# Copy to deploy/.env and replace every CHANGE_ME. Never commit deploy/.env.
DOMAIN=pslaser.online

# Generate each secret yourself, e.g.:
#   openssl rand -hex 24                      -> MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD
#   openssl rand -hex 32                      -> JWT_SECRET  (must be 32+ bytes; shared by Spring, Node and the website)
#   docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"   -> APP_KEY
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
APP_KEY=CHANGE_ME
