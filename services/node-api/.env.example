# Copy to .env (dotenv loads it at startup). All values below are the defaults.
NODE_ENV=development
PORT=4000
RAW_PORT=4001

DB_HOST=localhost
DB_PORT=3306
DB_NAME=pslaser
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10

# Must equal the Spring Boot API's JWT_SECRET (HS256, >= 32 bytes). Dev value only.
JWT_SECRET=pslaser-dev-secret-change-me-0123456789abcdef

CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:8000,http://localhost:8001,http://localhost:8080
WHATSAPP_NUMBER=917719976990
UPLOAD_MAX_MB=10
ENQUIRY_RATE_WINDOW_MIN=15
ENQUIRY_RATE_MAX=20
CATALOGUE_CACHE_SECONDS=60
REQUEST_LOG_FILE=requests.log
EVENT_LOG_FILE=events.log
