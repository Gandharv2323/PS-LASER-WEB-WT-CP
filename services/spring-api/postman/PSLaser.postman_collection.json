    {
      "name": "1 Auth",
      "item": [
        {
          "name": "Login (seed admin) - saves adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"has token + user without password\", () => { pm.expect(j.token).to.be.a(\"string\"); pm.expect(j.user.role).to.eql(\"admin\"); pm.expect(j.user).to.not.have.property(\"password\"); });",
                  "pm.environment.set(\"adminToken\", j.token);",
                  "const claims = JSON.parse(atob(j.token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "pm.test(\"JWT claims sub/email/role/exp\", () => { pm.expect(claims).to.include.keys(\"sub\",\"email\",\"role\",\"exp\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Seed admin from services/db/SEED_CREDENTIALS.md - put the password in the environment's adminPassword (secret).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login wrong password -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"CONTRACT error body\", () => { const j = pm.response.json(); pm.expect(j).to.include.keys(\"status\",\"error\",\"message\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
